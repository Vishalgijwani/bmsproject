<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Rhythm is fully on-device. No INTERNET permission, no analytics,
      no accounts, no notifications in v1. PACKAGE_USAGE_STATS is a special
      permission granted via Settings, not declared normally.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".RhythmApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Rhythm"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rhythm"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Rhythm"
            android:theme="@style/Theme.Rhythm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager uses default initializer (androidx.startup), no custom config -->
    </application>
</manifest>
